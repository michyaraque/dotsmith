1 ICON "../gpui/assets/dotsmith.ico"

1 VERSIONINFO
FILEVERSION DOTSMITH_MAJOR, DOTSMITH_MINOR, DOTSMITH_PATCH, 0
PRODUCTVERSION DOTSMITH_MAJOR, DOTSMITH_MINOR, DOTSMITH_PATCH, 0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Michael Araque"
            VALUE "FileDescription", "Dotsmith Setup"
            VALUE "FileVersion", DOTSMITH_VERSION
            VALUE "InternalName", "dotsmith-setup"
            VALUE "OriginalFilename", "dotsmith-setup.exe"
            VALUE "ProductName", "Dotsmith"
            VALUE "ProductVersion", DOTSMITH_VERSION
            VALUE "LegalCopyright", "Copyright (c) 2026 Michael Araque"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
